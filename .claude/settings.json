{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "disableAutoMode": "disable",
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm test *)",
      "Bash(npx vitest run *)",
      "Bash(npx jest *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Edit(/.github/**)",
      "Edit(/.claude/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/compose.yaml)",
      "Edit(/sonar-project.properties)",
      "Edit(/**/package.json)",
      "Edit(/**/package-lock.json)",
      "Edit(/api/src/app.module.ts)",
      "Edit(/shop/src/app/**)",
      "Edit(/backoffice/src/app/**)"
    ]
  }
}
