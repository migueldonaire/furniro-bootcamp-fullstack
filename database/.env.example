# Copy this file to database/.env (it is not uploaded to GitHub)
# Supabase -> Project Settings -> Data API: Project URL
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase -> Project Settings -> API Keys: secret key (sb_secret_...) or the old service_role key
SUPABASE_SECRET_KEY=CHANGE_ME
# Name of the bucket for the product images
SUPABASE_BUCKET=products
