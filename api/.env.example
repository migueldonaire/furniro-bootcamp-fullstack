# Local values: copy this file to .env (cp .env.example .env) and it works as it is
# against the database of `docker compose up -d`. They are NOT the values of
# staging or production: those live only in Render.

# Port of the API: http://localhost:3000/api/v1
PORT=3000

# Database of docker compose (user, password and name are in compose.yaml)
DATABASE_URL=postgres://furniro:furniro_dev_123@localhost:5432/furniro

# Key to sign the login tokens. Any long text works in local
JWT_SECRET=local-dev-secret-only-for-your-computer

# Webs that can call the API: shop (5173) and backoffice (5174)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Shipping cost in EUR, VAT included (only one place in the code)
SHIPPING_COST=8

# Emails with Brevo. Leave BREVO_API_KEY empty in local: the emails are printed
# in the console of the API (you will see the confirmation link there)
BREVO_API_KEY=
MAIL_FROM=furnirobootcampfullstack@gmail.com

# Shop URL, to build the links of the emails
SHOP_URL=http://localhost:5173
